column-unit  = "LCTLC/1.0", newline,
               unit-directive,
               [ defaults-directive ],
               frame, { frame } ;

unit-directive = "@unit", ws, kv-token, { ws, kv-token }, newline ;
defaults-directive = "@defaults", ws, kv-token, { ws, kv-token }, newline ;
frame = frame-directive, columns, row, { row }, "@end", newline ;
frame-directive = "@frame", ws, kv-token, { ws, kv-token }, newline ;
columns = "ID│LANE│OP│OUT│CTRL│IN│ARG│META", newline ;
row = cell, "│", cell, "│", cell, "│", cell, "│", cell, "│", cell, "│", cell, "│", cell, newline ;

(* IN contains A or A›B. ARG is the canonical PARAM payload. *)
(* META is semicolon-delimited key=value with quoted values when needed. *)
